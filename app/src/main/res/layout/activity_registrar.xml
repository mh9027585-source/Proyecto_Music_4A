<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegistrarActivity">


    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/imagen"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="30dp"
        app:cardElevation="35dp"
        app:cardCornerRadius="25dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="30dp"
            android:text="Regiatro de usuario"
            android:textColor="#FF6347"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- android:background="@drawable/bg_input" = pone la forma que creamos
         en res-drawable-nex-draw-->

        <!-- android:hint="Correo electronico" = poner dentro una "ayuda" -->

        <!-- android:paddingEnd="15dp" = poner un fin -->
        <!-- android:inputType="textEmailAddress" = proporciona un teclado para correo (es igual con el numDecimal) -->
        <!-- android:drawableStart="@drawable/baseline_email_24" = para mostrar
         el icono que pusimos con figuras de l isquierda, mas, y elegimos-->
        <!-- android:drawablePadding="10dp" = espacio del texto que tendra el texto -->
        <EditText
        android:id="@+id/etNombre"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/usuario"
        android:hint="Nombre"
        android:textColorHint="#000000"
        android:inputType="textEmailAddress"
        android:paddingStart="20dp"
        android:paddingEnd="15dp"
        android:textColor="#333333"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/baseline_alternate_email_24"/>


        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/texto"
            android:hint="Correo electronico"
            android:textColorHint="#000000"
            android:inputType="textEmailAddress"
            android:paddingStart="20dp"
            android:paddingEnd="15dp"
            android:textColor="#333333"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/baseline_alternate_email_24"/>


        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/texto"
            android:hint="Contraseña"
            android:textColorHint="#000000"
            android:inputType="textPassword"
            android:paddingStart="20dp"
            android:paddingEnd="15dp"
            android:textColor="#333333"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/baseline_back_hand_24"
            android:layout_marginTop="15dp"/>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegistrar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/button"
            android:layout_marginTop="25dp"
            android:text="Registrar"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>


        <!-- si no tiene cuenta -->
        <TextView
            android:id="@+id/tvCrearCuenta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear una cuenta"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="20dp"
            android:textStyle="bold"
            android:textColor="#000000"/>



    </LinearLayout>

</androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>